{
  "schema_version": 1,
  "formula_version": "r1-base-proposal-v1",
  "components": [
    "newsworthiness",
    "freshness",
    "breaking_potential",
    "curiosity",
    "controversy",
    "emotional_intensity",
    "recognizable_entities",
    "social_momentum",
    "search_interest",
    "visual_potential",
    "angle_novelty",
    "coverage_saturation",
    "source_confidence",
    "audience_relevance",
    "expected_short_term_traffic",
    "expected_long_tail_potential"
  ],
  "weights": {
    "audience_relevance": 0.3,
    "freshness": 0.25,
    "newsworthiness": 0.25,
    "curiosity": 0.2
  },
  "missing_policy": "withhold_score",
  "traffic_label": "Experimental relative estimate; not predicted pageviews",
  "coverage_label": "Estimate within monitored sources; not a whole-web measurement",
  "visibility": {
    "allow_story_without_angle": true,
    "allow_labeled_rumor_leads": true,
    "verification_is_independent": true
  },
  "notes": "Provisional fixed base index, not implemented or calibrated. Optional angle/social/search/traffic dimensions have no active weight."
}
